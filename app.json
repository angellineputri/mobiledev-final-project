{
  "expo": {
    "name": "tally",
    "slug": "tally",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tally",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tally uses your photos to picture your saving goals.",
          "cameraPermission": "Tally uses the camera to take photos for your saving goals."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing"
    ],
    "experiments": {}
  }
}
